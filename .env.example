# Публичное имя сервера, уже направленное DNS-записью на его IP.
APP_HOST=dog.example.com
# Для deploy/compose.macmini.example.yaml — полный адрес с существующим подпутём.
PUBLIC_URL=https://dog.example.com/barkodd/

# Один режим видео для всего сервера: websocket (по умолчанию) или webrtc.
MEDIA_TRANSPORT=websocket
# Используются только в webrtc. Пусто = публичный STUN по умолчанию; none = без STUN.
STUN_URLS=
# Адреса доступного извне TURN через запятую. Сам TURN запускается отдельно.
# TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
TURN_URLS=
# Shared secret coturn ИЛИ статические username/password. Не заполняйте оба варианта.
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=

# Авторизация: none — общий кабинет без входа; admin_code — вход владельца по коду;
# multi_user — самостоятельная регистрация по логину/паролю и отдельный админ.
# none открывает управление комнатами любому посетителю адреса.
AUTH_MODE=admin_code
# Требуется в admin_code/multi_user: 32–128 символов A-Z a-z 0-9 _ -.
# Сгенерировать: openssl rand -hex 32.
ADMIN_CODE=
# Прежнее имя ADMIN_CODE. Если заданы оба, значения должны совпадать.
ROOM_CREATION_KEY=
